# No trailing slash — trailing / causes //api/... and breaks CORS preflight
VITE_API_BASE_URL=http://127.0.0.1:5000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to true only after Google OAuth is configured in Supabase (see docs/DEPLOY.md Section G)
# VITE_ENABLE_GOOGLE_SIGNIN=true

# Azure Speech (Tagalog neural voice). Prefer .env.local so keys are not committed.
# VITE_AZURE_SPEECH_KEY=
# VITE_AZURE_SPEECH_REGION=eastasia
