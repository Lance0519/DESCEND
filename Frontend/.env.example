# No trailing slash — trailing / causes //api/... and breaks CORS preflight
VITE_API_BASE_URL=http://127.0.0.1:5000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Google sign-in shows automatically once Supabase keys are set. Set to false to hide it.
# VITE_ENABLE_GOOGLE_SIGNIN=false

# Address behind the "Contact us" link. Falls back to the maintainer's address if unset.
# VITE_SUPPORT_EMAIL=support@descendt2dm.me

# Azure Speech (Tagalog neural voice). Prefer .env.local so keys are not committed.
# VITE_AZURE_SPEECH_KEY=
# VITE_AZURE_SPEECH_REGION=eastasia
