# Backend local .env — copy to Backend/.env (never commit .env)
# For Vercel, paste these same KEY names in Project → Settings → Environment Variables.

FLASK_ENV=development
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# JWT Secret: Project Settings → API → JWT Settings (or Legacy JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Must be the secret "service_role" key (long eyJ... / sb_secret_...), NOT the publishable/anon key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Recommended on Vercel: Supabase → Project Settings → Database → Connection string (URI)
# Fill in your database password. App adds sslmode=require automatically.
# SQLALCHEMY_DATABASE_URI=postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
